rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTicket(data) {
      return data.ticketNumber is string && data.ticketNumber.size() <= 64
        && data.customerName is string && data.customerName.size() <= 150
        && data.customerPhone is string && data.customerPhone.size() <= 30
        && data.deviceType is string && data.deviceType.size() <= 30
        && data.status is string && data.status.size() <= 30;
    }

    function isValidInventory(data) {
      return data.itemCode is string && data.itemCode.size() <= 64
        && data.name is string && data.name.size() <= 200
        && data.category is string && data.category.size() <= 50;
    }

    // Repair tickets: Public customers can GET by exact ticket ID for QR tracking.
    // Shop operations can list, create, update, and delete with valid schema.
    match /repair_tickets/{ticketId} {
      allow get: if true;
      allow list: if true;
      allow create: if isValidTicket(request.resource.data);
      allow update: if isValidTicket(request.resource.data);
      allow delete: if true;
    }

    // Inventory items
    match /inventory/{itemId} {
      allow read: if true;
      allow create: if isValidInventory(request.resource.data);
      allow update: if isValidInventory(request.resource.data);
      allow delete: if true;
    }

    // Shop settings
    match /shop_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // POS sales & retail transactions
    match /pos_sales/{saleId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
